{
  "name": "events-service",
  "version": "3.0.0",
  "description": "Microsserviço de eventos e controle de vagas da plataforma events-tickets-ms, em JavaScript",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "babel src --out-dir dist --ignore \"src/**/*.spec.js,src/testing/**\"",
    "start": "node dist/main.js",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "amqplib": "^0.10.9",
    "axios": "^1.7.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.0",
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-transform-class-properties": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "roots": ["<rootDir>/src"],
    "testRegex": ".*\\.spec\\.js$",
    "testEnvironment": "node",
    "silent": true
  }
}
