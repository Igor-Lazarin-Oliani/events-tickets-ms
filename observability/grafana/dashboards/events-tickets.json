    {
      "id": 3,
      "type": "stat",
      "title": "logs-service",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Resultado da coleta do Prometheus no job logs-service: 1 se o /metrics respondeu na última coleta.",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"logs-service\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FORA DO AR",
                  "color": "red"
                },
                "1": {
                  "text": "NO AR",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
