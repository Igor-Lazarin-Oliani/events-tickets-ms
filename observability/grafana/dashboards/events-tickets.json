          "expr": "up{job=\"tickets-service\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FORA DO AR",
                  "color": "red"
                },
                "1": {
                  "text": "NO AR",
                  "color": "green"
                }
              }
            }
          ]
