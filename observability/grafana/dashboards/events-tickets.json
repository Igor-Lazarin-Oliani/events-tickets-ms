{
  "uid": "events-tickets",
  "title": "events-tickets-ms - Visão Geral",
  "tags": ["events-tickets-ms"],
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "events-tickets-service",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"events-tickets-service\"}", "instant": true}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "FORA DO AR", "color": "red"}, "1": {"text": "NO AR", "color": "green"}}}]}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "logs-service",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"logs-service\"}", "instant": true}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "FORA DO AR", "color": "red"}, "1": {"text": "NO AR", "color": "green"}}}]}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ingressos emitidos",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(tickets_issued_total) or vector(0)", "instant": true}],
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ingressos cancelados",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(tickets_cancelled_total) or vector(0)", "instant": true}],
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Vagas reservadas",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(events_spot_operations_total{operation=\"reserve\",result=\"success\"}) or vector(0)", "instant": true}],
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Registros de atividade gravados",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(logs_entries_created_total) or vector(0)", "instant": true}],
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requisições por segundo",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (job) (rate(http_requests_total[1m]))", "legendFormat": "{{job}}"}],
      "fieldConfig": {"defaults": {"min": 0, "unit": "reqps"}, "overrides": []}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latência p95",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"events-tickets-service\"}[1m])))", "legendFormat": "events-tickets-service"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"logs-service\"}[1m])))", "legendFormat": "logs-service"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "unit": "s"}, "overrides": []}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Respostas de erro por segundo (4xx e 5xx)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (job, status) (rate(http_requests_total{status=~\"[45]..\"}[1m]))", "legendFormat": "{{job}} {{status}}"}],
      "fieldConfig": {"defaults": {"min": 0, "unit": "reqps"}, "overrides": []}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Operações de vagas por segundo",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (operation, result) (rate(events_spot_operations_total[1m]))", "legendFormat": "{{operation}} {{result}}"}],
      "fieldConfig": {"defaults": {"min": 0, "unit": "ops"}, "overrides": []}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Requisições por rota",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (job, method, route, handler) (rate(http_requests_total[1m]))", "legendFormat": "{{job}} {{method}} {{route}}{{handler}}"}],
      "fieldConfig": {"defaults": {"min": 0, "unit": "reqps"}, "overrides": []}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Memória por serviço",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "process_resident_memory_bytes", "legendFormat": "{{job}}"}],
      "fieldConfig": {"defaults": {"min": 0, "unit": "bytes"}, "overrides": []}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Mensagens publicadas pela outbox (total)",
      "gridPos": {"x": 0, "y": 28, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (routing_key) (outbox_messages_published_total)", "legendFormat": "{{routing_key}}"}],
      "fieldConfig": {"defaults": {"min": 0, "decimals": 0}, "overrides": []}
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Mensagens consumidas pelo logs-service (total)",
      "gridPos": {"x": 8, "y": 28, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (result) (logs_messages_consumed_total)", "legendFormat": "{{result}}"}],
      "fieldConfig": {"defaults": {"min": 0, "decimals": 0}, "overrides": []}
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Mensagens aguardando na outbox",
      "gridPos": {"x": 16, "y": 28, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "outbox_messages_pending", "legendFormat": "pendentes"}],
      "fieldConfig": {"defaults": {"min": 0, "decimals": 0}, "overrides": []}
    }
  ]
}
